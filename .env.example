# Gmail: smtp.gmail.com, port 587, MAIL_USE_TLS=true, MAIL_USE_SSL=false.
# Outlook.com: smtp-mail.outlook.com, port 587, MAIL_USE_TLS=true, MAIL_USE_SSL=false.
# QQ Mail: smtp.qq.com, port 465, MAIL_USE_TLS=false, MAIL_USE_SSL=true.
MAIL_SERVER=smtp.qq.com
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=your-sender@qq.com
MAIL_PASSWORD=your-qq-mail-authorization-code
MAIL_DEFAULT_SENDER=your-sender@qq.com
ADMIN_EMAIL=admin@example.com
APP_TIMEZONE=Asia/Shanghai
ANSWERBOOK_ADMIN_TOKEN=replace-with-a-long-random-secret
